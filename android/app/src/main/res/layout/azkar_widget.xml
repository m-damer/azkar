<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:importantForAccessibility="yes"
            android:scaleType="fitCenter"
            android:tint="@color/widget_title" />

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/widget_prev"
            android:padding="6dp"
            android:src="@drawable/ic_widget_prev"
            android:tint="@color/widget_title"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/widget_next"
            android:padding="6dp"
            android:src="@drawable/ic_widget_next"
            android:tint="@color/widget_title"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:importantForAccessibility="yes"
        android:scaleType="fitCenter"
        android:tint="@color/widget_text" />
</LinearLayout>
