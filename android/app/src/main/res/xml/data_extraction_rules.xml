<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and direct phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <include domain="sharedpref" path="azkar_widget.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <include domain="sharedpref" path="azkar_widget.xml"/>
    </device-transfer>
</data-extraction-rules>
